# Chép thành `.env` rồi sửa. File `.env` bị .gitignore chặn, KHÔNG lên git.
#
# LƯU Ý QUAN TRỌNG: chỉ `docker compose` đọc file này. .NET KHÔNG tự đọc .env.
# Chạy backend bằng `dotnet run` thì phải tự đặt biến môi trường trong shell.


# ---------------------------------------------------------------- bắt buộc

# Mật khẩu tài khoản `sa` của SQL Server. Dùng cho cả container SQL lẫn chuỗi
# kết nối của backend, nên đổi ở đây là đổi cả hai.
#
# SQL Server từ chối mật khẩu yếu — container sẽ chết ngay khi khởi động.
#
# BẪY TRÊN MÁY ĐÃ CHẠY TỪ TRƯỚC: mật khẩu `sa` được đặt MỘT LẦN lúc container
# SQL tạo database lần đầu, rồi nằm trong volume `sql-data`. Đổi biến này sau
# đó KHÔNG đổi mật khẩu thật — nó chỉ làm chuỗi kết nối sai và backend không
# vào được. Máy đang chạy thì phải điền ĐÚNG mật khẩu đã dùng từ đầu. Muốn đổi
# thật thì phải xoá volume, và xoá volume là mất sạch dữ liệu.
SQL_SA_PASSWORD=<mật khẩu đã dùng khi tạo database>


# ---------------------------------------------------------------- nên đặt

# Địa chỉ trói cổng 5000 của backend.
#   127.0.0.1      chỉ máy này gọi được (mặc định nếu không đặt)
#   100.x.x.x      địa chỉ Tailscale — mọi máy trong tailnet gọi được
#   0.0.0.0        mở ra mọi card mạng. Đừng, khi chưa có xác thực đầy đủ.
# Lấy địa chỉ Tailscale của máy đang ngồi:  tailscale ip -4
API_BIND=127.0.0.1

# Địa chỉ mà MÁY BENCH dùng để tải gói test case về. Phải là địa chỉ máy bench
# với tới được, không phải localhost. Dùng tên MagicDNS thay IP thô thì đổi IP
# Tailscale không phải sửa lại.
BENCH_BASE_URL=http://vinfast.tail1cbef5.ts.net:5000

# Khoá ký JWT, ít nhất 32 ký tự. Không đặt thì backend sinh ngẫu nhiên mỗi lần
# khởi động, tức là mọi người đang đăng nhập bị đăng xuất sau mỗi lần restart.
# Sinh một chuỗi ngẫu nhiên:
#   powershell -c "[Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))"
JWT_KEY=


# ------------------------------------------------- chỉ dùng lần dựng đầu tiên

# Tài khoản quản trị đầu tiên. Chỉ có tác dụng khi database CHƯA có người dùng
# nào. Để trống thì backend sinh mật khẩu ngẫu nhiên và in ra log ĐÚNG MỘT LẦN
# — mất là phải xoá bản ghi user rồi cho seed chạy lại.
ADMIN_EMAIL=
ADMIN_PASSWORD=
