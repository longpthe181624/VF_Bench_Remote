# Chép thành `.env` trên máy A rồi sửa. Docker Compose tự đọc file này.

# Địa chỉ trói cổng 5000 của backend.
#
#   127.0.0.1      chỉ máy A gọi được (mặc định nếu không đặt)
#   100.69.35.102  địa chỉ Tailscale của máy A — mọi máy trong tailnet gọi được,
#                  mạng công ty thì không. Đây là lựa chọn đang dùng.
#   0.0.0.0        mở ra mọi card mạng. ĐỪNG, khi backend chưa có xác thực.
#
# Lấy địa chỉ Tailscale của máy đang ngồi:  tailscale ip -4
API_BIND=100.69.35.102
